{
  "routes": [
    {
      "src": "/",
      "has": [
        {
          "type": "header",
          "key": "Accept",
          "value": "(?i).*text/markdown.*"
        }
      ],
      "dest": "/api/markdown-index"
    },
    {
      "src": "/",
      "headers": {
        "Vary": "Accept"
      },
      "continue": true
    },
    {
      "src": "/mjp",
      "dest": "/mjp.html"
    },
    {
      "src": "/mjp.html",
      "status": 301,
      "headers": { "Location": "/mjp" }
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/404" }
  ]
}
